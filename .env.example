# Copy this file to .env.local and fill in both values from your Supabase project:
# Project Settings > API Keys (the key) and Project Settings > Data API (the URL).
# Leave them empty to run in demo mode, where progress is saved in the browser.
#
# Both values are meant to be public: they end up in the browser, and row level
# security protects the data. Never put the secret or service_role key here.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
